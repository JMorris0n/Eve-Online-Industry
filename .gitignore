# Generated LLM exports. Keep templates and hand-authored permanent files.
exports/generated/

# Temporary research artifacts
*.tmp
*.bak
*.log~

# Operating-system files
.DS_Store
Thumbs.db

# VS Code workspace settings are local by default
.vscode/

# Local source data and generated datasets. Do not commit CCP SDE archives.
data/raw/
data/processed/
data/cache/

# Python tooling
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Local credentials and environment files
.env
.env.*
!.env.example
