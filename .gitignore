# Generated LLM exports. Keep templates and hand-authored permanent files.
exports/generated/

# Temporary research artifacts
*.tmp
*.bak
*.log~

# Operating-system files
.DS_Store
Thumbs.db

# VS Code workspace settings are local by default
.vscode/

# Local source data and generated datasets. Do not commit CCP SDE archives.
data/raw/
data/processed/
data/derived/
data/cache/
tools/esi/config.json

# Private local operation data. Never commit character, asset, blueprint,
# balance, order, or facility-access exports to the public repository.
data/private/
data/user/
local/
*.local.json
*.local.yaml
*.local.yml
*.secrets.json

# Python tooling
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Local credentials and environment files
.env
.env.*
!.env.example

# Private local EVE SSO client configuration; refresh tokens are held in the OS keyring
tools/esi/sso-config.json
