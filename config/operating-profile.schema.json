{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JMorris0n/Eve-Online-Industry/blob/main/config/operating-profile.schema.json",
  "title": "EVE Industry Local Operating Profile",
  "description": "Private local operating inputs. Never commit populated profiles, exports, or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "profile_name",
    "characters",
    "capital",
    "operations",
    "facilities",
    "blueprints",
    "blueprints_state",
    "facilities_state"
  ],
  "properties": {
    "profile_version": {
      "const": 1
    },
    "profile_name": {
      "type": "string",
      "minLength": 1
    },
    "last_reviewed": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "characters": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "capital": {
      "$ref": "#/$defs/capital"
    },
    "operations": {
      "$ref": "#/$defs/operations"
    },
    "facilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/facility"
      }
    },
    "blueprints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blueprint"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blueprints_state": {
      "$ref": "#/$defs/state"
    },
    "facilities_state": {
      "$ref": "#/$defs/state"
    },
    "market_access": {
      "$ref": "#/$defs/marketAccess"
    },
    "logistics": {
      "$ref": "#/$defs/logistics"
    }
  },
  "$defs": {
    "state": {
      "type": "string",
      "enum": [
        "unknown",
        "partial",
        "verified"
      ]
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "label",
        "state",
        "skills",
        "job_capacity",
        "skills_state"
      ],
      "properties": {
        "slot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "skills": {
          "type": "object",
          "description": "Skill type ID (as a decimal string) to trained level (0-5). A missing skill is level zero only when skills_state is verified.",
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "job_capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manufacturing",
            "science",
            "reaction"
          ],
          "properties": {
            "manufacturing": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "science": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "reaction": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "specializations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills_state": {
          "$ref": "#/$defs/state"
        }
      }
    },
    "capital": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "working_capital_isk",
        "liquidity_reserve_isk",
        "max_capital_at_risk_isk"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "working_capital_isk": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "liquidity_reserve_isk": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_capital_at_risk_isk": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "active_hours_per_week",
        "max_setup_minutes_per_batch",
        "target_liquidation_days",
        "risk_tolerance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "active_hours_per_week": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_setup_minutes_per_batch": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "target_liquidation_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "risk_tolerance": {
          "type": "string",
          "enum": [
            "unknown",
            "low",
            "moderate",
            "high"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "facility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "state"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "system_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "structure_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rigs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tax_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "access_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_id",
        "state",
        "kind",
        "quantity"
      ],
      "properties": {
        "type_id": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "kind": {
          "type": "string",
          "enum": [
            "BPO",
            "BPC"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "material_efficiency": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "time_efficiency": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "licensed_runs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "location_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "marketAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "locations"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marketLocation"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "marketLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "state",
        "market_type",
        "roles"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "market_type": {
          "type": "string",
          "enum": [
            "unknown",
            "npc_station",
            "upwell_structure"
          ]
        },
        "region_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "system_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "location_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "procurement",
              "sales"
            ]
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "logistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "preferred_method",
        "max_route_jumps",
        "max_active_minutes_per_batch",
        "max_cargo_m3"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "preferred_method": {
          "type": "string",
          "enum": [
            "unknown",
            "self_haul",
            "courier",
            "either",
            "none"
          ]
        },
        "max_route_jumps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_active_minutes_per_batch": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_cargo_m3": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
